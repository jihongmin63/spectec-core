# jar + its runner, and the maude/MTT scratch files they write.
spectec/tools/maude271-hooks/
spectec/tools/mfe271/
spectec/tools/aprove/
spectec/tools/yices/
spectec/tools/yices1/
spectec/tools/z3/
spectec/log.txt
spectec/term_sweep.tsv
spectec/.hook-check

