  eq isStuckHead(match-some(V0:Opt)) = true .
  eq isStuckHead(match-type-BOOL-0(V0:Type)) = true .
  eq isStuckHead(match-type-INT-0(V0:Type)) = true .
  eq isStuckHead(not(V0:BoolV)) = true .
  eq isStuckHead(subty-id(V0:Val)) = true .
  eq isStuckHead(subty-literal(V0:Val)) = true .
  eq isStuckHead(D:Val) = false [owise] .
endm

