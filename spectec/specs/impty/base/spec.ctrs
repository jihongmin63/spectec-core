  ceq $lookup(pair<K, V>, K_query) = $lookup($itermap_K_t_minus_gt_V_t_list_2_pair(K_t, V_t), K_query) if match_cons(pair<K, V>) = true /\ pair<K, V> = cons(variant_pair_minus_gt_2(K_h, V_h), iterbind_0) /\ $unzip_K_t_minus_gt_V_t_list_K_t(iterbind_0) = K_t /\ $unzip_K_t_minus_gt_V_t_list_V_t(iterbind_0) = V_t [owise] .
  ceq Check_expr(tenv, expr) = variant_type_INT_0 if subty_literal(expr) = true /\ expr = literal /\ match_literal_NUM_1(literal) = true /\ literal = variant_literal_NUM_1(i) .
  ceq Check_expr(tenv, expr) = variant_type_BOOL_0 if subty_literal(expr) = true /\ expr = literal /\ match_literal_BOOL_1(literal) = true /\ literal = variant_literal_BOOL_1(b) .
  ceq Check_expr(tenv, expr) = t if subty_id(expr) = true /\ expr = x /\ $lookup(tenv, x) = type /\ match_some(type) = true /\ type = some(t) .
  ceq Check_expr(tenv, expr) = variant_type_BOOL_0 if match_expr_bang_1(expr) = true /\ expr = variant_expr_bang_1(e) /\ Check_expr(tenv, e) = type /\ match_type_BOOL_0(type) = true .
  ceq Check_expr(tenv, expr) = variant_type_INT_0 if match_expr_plus_2(expr) = true /\ expr = variant_expr_plus_2(e_l, e_r) /\ Check_expr(tenv, e_l) = type /\ match_type_INT_0(type) = true /\ Check_expr(tenv, e_r) = type' /\ match_type_INT_0(type') = true .
  ceq Check_expr(tenv, expr) = variant_type_BOOL_0 if match_expr_lt_eq_2(expr) = true /\ expr = variant_expr_lt_eq_2(e_l, e_r) /\ Check_expr(tenv, e_l) = type /\ match_type_INT_0(type) = true /\ Check_expr(tenv, e_r) = type' /\ match_type_INT_0(type') = true .
  ceq Check_expr(tenv, expr) = variant_type_BOOL_0 if match_expr_amp_amp_2(expr) = true /\ expr = variant_expr_amp_amp_2(e_l, e_r) /\ Check_expr(tenv, e_l) = type /\ match_type_BOOL_0(type) = true /\ Check_expr(tenv, e_r) = type' /\ match_type_BOOL_0(type') = true .
  ceq Check_command(tenv, command) = tenv if match_command_SKIP_0(command) = true .
  ceq Check_command(tenv, command) = cons(variant_pair_minus_gt_2(x, t), tenv) if match_command_eq_3(command) = true /\ command = variant_command_eq_3(t, x, e) /\ Check_expr(tenv, e) = type /\ type = t .
  ceq Check_command(tenv, command) = tenv if match_command_eq_2(command) = true /\ command = variant_command_eq_2(x, e) /\ Check_expr(tenv, e) = t /\ $lookup(tenv, x) = some(t) .
