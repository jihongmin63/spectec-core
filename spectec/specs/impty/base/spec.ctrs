  ceq Check_command(tenv, command) = tenv_2 if match_command_semi_2(command) = true /\ command = variant_command_semi_2(c_1, c_2) /\ Check_command(tenv, c_1) = tenv_1 /\ Check_command(tenv_1, c_2) = tenv_2 .
  ceq Check_prog(command) = true if Check_command(nil, command) = tenv .
  ceq Eval_expr(env, expr) = variant_literal_NUM_1(i) if subty_literal(expr) = true /\ expr = literal /\ match_literal_NUM_1(literal) = true /\ literal = variant_literal_NUM_1(i) .
  ceq Eval_expr(env, expr) = variant_literal_BOOL_1(b) if subty_literal(expr) = true /\ expr = literal /\ match_literal_BOOL_1(literal) = true /\ literal = variant_literal_BOOL_1(b) .
