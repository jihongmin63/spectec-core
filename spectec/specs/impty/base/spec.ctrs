set include BOOL off .

(mod SPEC is
  sorts BoolV Command Expr Id IntV List Literal NatV Opt Pair Text Type Val .
  subsorts BoolV Command Expr Id IntV List Literal NatV Opt Pair Text Type < Val .
  subsort Id < Expr .
  subsort List < Text .
  subsort Literal < Expr .

  op $itermap-K-t-minus-gt-V-t-list-2-pair : Val Val -> Val .
  op $lookup : List Val -> Opt .
  op $unzip-K-t-minus-gt-V-t-list-K-t : Val -> Val .
  op $unzip-K-t-minus-gt-V-t-list-V-t : Val -> Val .
  op Check-command : List Command -> List .
  op Check-expr : List Expr -> Type .
  op Check-prog : Command -> BoolV .
  op Eval-command : List Command -> List .
  op Eval-expr : List Expr -> Literal .
  op Eval-prog : Command -> List .
  op Run-prog : Command -> List .
  op add : NatV NatV -> NatV .
  op add-int : IntV IntV -> IntV .
  op and : BoolV BoolV -> BoolV .
  op cons : Val List -> List .
  op eqg : Val Val -> BoolV .
  op false : -> BoolV .
  op int-neg : NatV -> IntV .
  op int-pos : NatV -> IntV .
  op leq : NatV NatV -> BoolV .
  op leq-int : IntV IntV -> BoolV .
  op match-command-IF-THEN-ELSE-END-3 : Command -> BoolV .
  op match-command-SKIP-0 : Command -> BoolV .
  op match-command-WHILE-DO-END-2 : Command -> BoolV .
  op match-command-eq-2 : Command -> BoolV .
  op match-command-eq-3 : Command -> BoolV .
  op match-command-semi-2 : Command -> BoolV .
  op match-cons : List -> BoolV .
  op match-expr-amp-amp-2 : Expr -> BoolV .
  op match-expr-bang-1 : Expr -> BoolV .
  op match-expr-lt-eq-2 : Expr -> BoolV .
  op match-expr-plus-2 : Expr -> BoolV .
  op match-literal-BOOL-1 : Literal -> BoolV .
  op match-literal-NUM-1 : Literal -> BoolV .
  op match-nil : List -> BoolV .
  op match-some : Opt -> BoolV .
  op match-type-BOOL-0 : Type -> BoolV .
  op match-type-INT-0 : Type -> BoolV .
  op nil : -> List .
  op none : -> Opt .
  op not : BoolV -> BoolV .
  op or : BoolV BoolV -> BoolV .
  op proj-cons-0 : Val -> Val .
  op proj-variant-pair-minus-gt-2-0 : Val -> Val .
  op some : Val -> Opt .
  op sub-int-nat : NatV NatV -> IntV .
  op subty-id : Val -> BoolV .
  op subty-literal : Val -> BoolV .
  op succ : NatV -> NatV .
  op true : -> BoolV .
  op variant-command-IF-THEN-ELSE-END-3 : Expr Command Command -> Command .
  op variant-command-SKIP-0 : -> Command .
  op variant-command-WHILE-DO-END-2 : Expr Command -> Command .
  op variant-command-eq-2 : Id Expr -> Command .
  op variant-command-eq-3 : Type Id Expr -> Command .
  op variant-command-semi-2 : Command Command -> Command .
  op variant-expr-amp-amp-2 : Expr Expr -> Expr .
  op variant-expr-bang-1 : Expr -> Expr .
  op variant-expr-lt-eq-2 : Expr Expr -> Expr .
  op variant-expr-plus-2 : Expr Expr -> Expr .
  op variant-id-ID-1 : Text -> Id .
  op variant-literal-BOOL-1 : BoolV -> Literal .
  op variant-literal-NUM-1 : IntV -> Literal .
  op variant-pair-minus-gt-2 : Val Val -> Pair .
  op variant-type-BOOL-0 : -> Type .
  op variant-type-INT-0 : -> Type .
  op zero : -> NatV .

  eq not(true) = false .
  eq not(false) = true .
  eq and(true, y:BoolV) = y:BoolV .
  eq and(false, y:BoolV) = false .
  eq add(zero, y:NatV) = y:NatV .
  eq add(succ(x:NatV), y:NatV) = succ(add(x:NatV, y:NatV)) .
  eq leq(zero, y:NatV) = true .
  eq leq(succ(x:NatV), zero) = false .
  eq leq(succ(x:NatV), succ(y:NatV)) = leq(x:NatV, y:NatV) .
  eq sub-int-nat(zero, zero) = int-pos(zero) .
  eq sub-int-nat(succ(x:NatV), zero) = int-pos(succ(x:NatV)) .
  eq sub-int-nat(zero, succ(y:NatV)) = int-neg(y:NatV) .
  eq sub-int-nat(succ(x:NatV), succ(y:NatV)) = sub-int-nat(x:NatV, y:NatV) .
  eq add-int(int-pos(x:NatV), int-pos(y:NatV)) = int-pos(add(x:NatV, y:NatV)) .
  eq add-int(int-neg(x:NatV), int-neg(y:NatV)) = int-neg(succ(add(x:NatV, y:NatV))) .
  eq add-int(int-pos(x:NatV), int-neg(y:NatV)) = sub-int-nat(x:NatV, succ(y:NatV)) .
  eq add-int(int-neg(x:NatV), int-pos(y:NatV)) = sub-int-nat(y:NatV, succ(x:NatV)) .
  eq leq-int(int-pos(x:NatV), int-pos(y:NatV)) = leq(x:NatV, y:NatV) .
  eq leq-int(int-neg(x:NatV), int-neg(y:NatV)) = leq(y:NatV, x:NatV) .
  eq leq-int(int-pos(x:NatV), int-neg(y:NatV)) = false .
  eq leq-int(int-neg(x:NatV), int-pos(y:NatV)) = true .
  eq match-some(some(x:Val)) = true .
  eq match-some(none) = false .
  eq match-cons(cons(x:Val, xs:List)) = true .
  eq match-cons(nil) = false .
  eq match-nil(nil) = true .
  eq match-nil(cons(x:Val, xs:List)) = false .
  eq match-type-INT-0(variant-type-INT-0) = true .
  eq match-type-INT-0(variant-type-BOOL-0) = false .
  eq match-type-BOOL-0(variant-type-INT-0) = false .
  eq match-type-BOOL-0(variant-type-BOOL-0) = true .
  eq match-literal-NUM-1(variant-literal-NUM-1(x0:IntV)) = true .
  eq match-literal-NUM-1(variant-literal-BOOL-1(x0:BoolV)) = false .
  eq match-literal-BOOL-1(variant-literal-NUM-1(x0:IntV)) = false .
  eq match-literal-BOOL-1(variant-literal-BOOL-1(x0:BoolV)) = true .
  eq subty-literal(variant-literal-NUM-1(x0:IntV)) = true .
  eq subty-literal(variant-literal-BOOL-1(x0:BoolV)) = true .
  eq subty-id(variant-id-ID-1(x0:Text)) = true .
  eq match-expr-bang-1(variant-literal-NUM-1(x0:IntV)) = false .
  eq match-expr-bang-1(variant-literal-BOOL-1(x0:BoolV)) = false .
  eq match-expr-bang-1(variant-id-ID-1(x0:Text)) = false .
  eq match-expr-bang-1(variant-expr-bang-1(x0:Expr)) = true .
  eq match-expr-bang-1(variant-expr-plus-2(x0:Expr, x1:Expr)) = false .
  eq match-expr-bang-1(variant-expr-lt-eq-2(x0:Expr, x1:Expr)) = false .
  eq match-expr-bang-1(variant-expr-amp-amp-2(x0:Expr, x1:Expr)) = false .
  eq match-expr-plus-2(variant-literal-NUM-1(x0:IntV)) = false .
  eq match-expr-plus-2(variant-literal-BOOL-1(x0:BoolV)) = false .
  eq match-expr-plus-2(variant-id-ID-1(x0:Text)) = false .
  eq match-expr-plus-2(variant-expr-bang-1(x0:Expr)) = false .
  eq match-expr-plus-2(variant-expr-plus-2(x0:Expr, x1:Expr)) = true .
  eq match-expr-plus-2(variant-expr-lt-eq-2(x0:Expr, x1:Expr)) = false .
  eq match-expr-plus-2(variant-expr-amp-amp-2(x0:Expr, x1:Expr)) = false .
  eq match-expr-lt-eq-2(variant-literal-NUM-1(x0:IntV)) = false .
  eq match-expr-lt-eq-2(variant-literal-BOOL-1(x0:BoolV)) = false .
  eq match-expr-lt-eq-2(variant-id-ID-1(x0:Text)) = false .
  eq match-expr-lt-eq-2(variant-expr-bang-1(x0:Expr)) = false .
  eq match-expr-lt-eq-2(variant-expr-plus-2(x0:Expr, x1:Expr)) = false .
  eq match-expr-lt-eq-2(variant-expr-lt-eq-2(x0:Expr, x1:Expr)) = true .
  eq match-expr-lt-eq-2(variant-expr-amp-amp-2(x0:Expr, x1:Expr)) = false .
  eq match-expr-amp-amp-2(variant-literal-NUM-1(x0:IntV)) = false .
  eq match-expr-amp-amp-2(variant-literal-BOOL-1(x0:BoolV)) = false .
  eq match-expr-amp-amp-2(variant-id-ID-1(x0:Text)) = false .
  eq match-expr-amp-amp-2(variant-expr-bang-1(x0:Expr)) = false .
  eq match-expr-amp-amp-2(variant-expr-plus-2(x0:Expr, x1:Expr)) = false .
  eq match-expr-amp-amp-2(variant-expr-lt-eq-2(x0:Expr, x1:Expr)) = false .
  eq match-expr-amp-amp-2(variant-expr-amp-amp-2(x0:Expr, x1:Expr)) = true .
  eq match-command-SKIP-0(variant-command-SKIP-0) = true .
  eq match-command-SKIP-0(variant-command-eq-3(x0:Type, x1:Id, x2:Expr)) = false .
  eq match-command-SKIP-0(variant-command-eq-2(x0:Id, x1:Expr)) = false .
  eq match-command-SKIP-0(variant-command-IF-THEN-ELSE-END-3(x0:Expr, x1:Command, x2:Command)) = false .
  eq match-command-SKIP-0(variant-command-WHILE-DO-END-2(x0:Expr, x1:Command)) = false .
  eq match-command-SKIP-0(variant-command-semi-2(x0:Command, x1:Command)) = false .
  eq match-command-eq-3(variant-command-SKIP-0) = false .
  eq match-command-eq-3(variant-command-eq-3(x0:Type, x1:Id, x2:Expr)) = true .
  eq match-command-eq-3(variant-command-eq-2(x0:Id, x1:Expr)) = false .
  eq match-command-eq-3(variant-command-IF-THEN-ELSE-END-3(x0:Expr, x1:Command, x2:Command)) = false .
  eq match-command-eq-3(variant-command-WHILE-DO-END-2(x0:Expr, x1:Command)) = false .
  eq match-command-eq-3(variant-command-semi-2(x0:Command, x1:Command)) = false .
  eq match-command-eq-2(variant-command-SKIP-0) = false .
  eq match-command-eq-2(variant-command-eq-3(x0:Type, x1:Id, x2:Expr)) = false .
  eq match-command-eq-2(variant-command-eq-2(x0:Id, x1:Expr)) = true .
  eq match-command-eq-2(variant-command-IF-THEN-ELSE-END-3(x0:Expr, x1:Command, x2:Command)) = false .
  eq match-command-eq-2(variant-command-WHILE-DO-END-2(x0:Expr, x1:Command)) = false .
  eq match-command-eq-2(variant-command-semi-2(x0:Command, x1:Command)) = false .
  eq match-command-IF-THEN-ELSE-END-3(variant-command-SKIP-0) = false .
  eq match-command-IF-THEN-ELSE-END-3(variant-command-eq-3(x0:Type, x1:Id, x2:Expr)) = false .
  eq match-command-IF-THEN-ELSE-END-3(variant-command-eq-2(x0:Id, x1:Expr)) = false .
  eq match-command-IF-THEN-ELSE-END-3(variant-command-IF-THEN-ELSE-END-3(x0:Expr, x1:Command, x2:Command)) = true .
  eq match-command-IF-THEN-ELSE-END-3(variant-command-WHILE-DO-END-2(x0:Expr, x1:Command)) = false .
  eq match-command-IF-THEN-ELSE-END-3(variant-command-semi-2(x0:Command, x1:Command)) = false .
  eq match-command-WHILE-DO-END-2(variant-command-SKIP-0) = false .
  eq match-command-WHILE-DO-END-2(variant-command-eq-3(x0:Type, x1:Id, x2:Expr)) = false .
  eq match-command-WHILE-DO-END-2(variant-command-eq-2(x0:Id, x1:Expr)) = false .
  eq match-command-WHILE-DO-END-2(variant-command-IF-THEN-ELSE-END-3(x0:Expr, x1:Command, x2:Command)) = false .
  eq match-command-WHILE-DO-END-2(variant-command-WHILE-DO-END-2(x0:Expr, x1:Command)) = true .
  eq match-command-WHILE-DO-END-2(variant-command-semi-2(x0:Command, x1:Command)) = false .
  eq match-command-semi-2(variant-command-SKIP-0) = false .
  eq match-command-semi-2(variant-command-eq-3(x0:Type, x1:Id, x2:Expr)) = false .
  eq match-command-semi-2(variant-command-eq-2(x0:Id, x1:Expr)) = false .
  eq match-command-semi-2(variant-command-IF-THEN-ELSE-END-3(x0:Expr, x1:Command, x2:Command)) = false .
  eq match-command-semi-2(variant-command-WHILE-DO-END-2(x0:Expr, x1:Command)) = false .
  eq match-command-semi-2(variant-command-semi-2(x0:Command, x1:Command)) = true .
  eq $itermap-K-t-minus-gt-V-t-list-2-pair(nil, nil) = nil .
  eq $itermap-K-t-minus-gt-V-t-list-2-pair(cons(K-t--hd:Val, K-t--tl:List), cons(V-t--hd:Val, V-t--tl:List)) = cons(variant-pair-minus-gt-2(K-t--hd:Val, V-t--hd:Val), $itermap-K-t-minus-gt-V-t-list-2-pair(K-t--tl:List, V-t--tl:List)) .
  eq $unzip-K-t-minus-gt-V-t-list-V-t(nil) = nil .
  eq $unzip-K-t-minus-gt-V-t-list-V-t(cons(variant-pair-minus-gt-2(K-t--hd:Val, V-t--hd:Val), --rest:List)) = cons(V-t--hd:Val, $unzip-K-t-minus-gt-V-t-list-V-t(--rest:List)) .
  eq $unzip-K-t-minus-gt-V-t-list-K-t(nil) = nil .
  eq $unzip-K-t-minus-gt-V-t-list-K-t(cons(variant-pair-minus-gt-2(K-t--hd:Val, V-t--hd:Val), --rest:List)) = cons(K-t--hd:Val, $unzip-K-t-minus-gt-V-t-list-K-t(--rest:List)) .
  eq subty-literal(variant-id-ID-1(x0:Text)) = false .
  eq subty-literal(variant-expr-bang-1(x0:Expr)) = false .
  eq subty-literal(variant-expr-plus-2(x0:Expr, x1:Expr)) = false .
  eq subty-literal(variant-expr-lt-eq-2(x0:Expr, x1:Expr)) = false .
  eq subty-literal(variant-expr-amp-amp-2(x0:Expr, x1:Expr)) = false .
  eq subty-id(variant-literal-NUM-1(x0:IntV)) = false .
  eq subty-id(variant-literal-BOOL-1(x0:BoolV)) = false .
  eq subty-id(variant-expr-bang-1(x0:Expr)) = false .
  eq subty-id(variant-expr-plus-2(x0:Expr, x1:Expr)) = false .
  eq subty-id(variant-expr-lt-eq-2(x0:Expr, x1:Expr)) = false .
  eq subty-id(variant-expr-amp-amp-2(x0:Expr, x1:Expr)) = false .
  eq $lookup(nil, K-query:Val) = none .
  ceq $lookup(pair-lt-K-comma-V-gt:List, K-query:Val) = some(V-h:Val) if match-cons(pair-lt-K-comma-V-gt:List) = true /\ pair-lt-K-comma-V-gt:List = cons(variant-pair-minus-gt-2(K-query:Val, V-h:Val), iterbind-0:List) /\ $unzip-K-t-minus-gt-V-t-list-K-t(iterbind-0:List) = K-t:Val /\ $unzip-K-t-minus-gt-V-t-list-V-t(iterbind-0:List) = V-t:Val .
  ceq $lookup(pair-lt-K-comma-V-gt:List, K-query:Val) = $lookup($itermap-K-t-minus-gt-V-t-list-2-pair($unzip-K-t-minus-gt-V-t-list-K-t(iterbind-0:List), $unzip-K-t-minus-gt-V-t-list-V-t(iterbind-0:List)), K-query:Val) if match-cons(pair-lt-K-comma-V-gt:List) = true /\ pair-lt-K-comma-V-gt:List = cons(variant-pair-minus-gt-2(K-h:Val, V-h:Val), iterbind-0:List) /\ or(eqg(pair-lt-K-comma-V-gt:List, nil), and(match-cons(pair-lt-K-comma-V-gt:List), eqg(K-query:Val, proj-variant-pair-minus-gt-2-0(proj-cons-0(pair-lt-K-comma-V-gt:List))))) = false .
  ceq Check-expr(tenv:List, expr:Literal) = variant-type-INT-0 if subty-literal(expr:Literal) = true /\ match-literal-NUM-1(expr:Literal) = true /\ expr:Literal = variant-literal-NUM-1(i:IntV) .
  ceq Check-expr(tenv:List, expr:Literal) = variant-type-BOOL-0 if subty-literal(expr:Literal) = true /\ match-literal-BOOL-1(expr:Literal) = true /\ expr:Literal = variant-literal-BOOL-1(b:BoolV) .
  ceq Check-expr(tenv:List, expr:Expr) = t:Type if subty-id(expr:Expr) = true /\ $lookup(tenv:List, expr:Expr) = type:Opt /\ match-some(type:Opt) = true /\ type:Opt = some(t:Type) .
  ceq Check-expr(tenv:List, expr:Expr) = variant-type-BOOL-0 if match-expr-bang-1(expr:Expr) = true /\ expr:Expr = variant-expr-bang-1(e:Expr) /\ match-type-BOOL-0(Check-expr(tenv:List, e:Expr)) = true .
  ceq Check-expr(tenv:List, expr:Expr) = variant-type-INT-0 if match-expr-plus-2(expr:Expr) = true /\ expr:Expr = variant-expr-plus-2(e-l:Expr, e-r:Expr) /\ match-type-INT-0(Check-expr(tenv:List, e-l:Expr)) = true /\ match-type-INT-0(Check-expr(tenv:List, e-r:Expr)) = true .
  ceq Check-expr(tenv:List, expr:Expr) = variant-type-BOOL-0 if match-expr-lt-eq-2(expr:Expr) = true /\ expr:Expr = variant-expr-lt-eq-2(e-l:Expr, e-r:Expr) /\ match-type-INT-0(Check-expr(tenv:List, e-l:Expr)) = true /\ match-type-INT-0(Check-expr(tenv:List, e-r:Expr)) = true .
  ceq Check-expr(tenv:List, expr:Expr) = variant-type-BOOL-0 if match-expr-amp-amp-2(expr:Expr) = true /\ expr:Expr = variant-expr-amp-amp-2(e-l:Expr, e-r:Expr) /\ match-type-BOOL-0(Check-expr(tenv:List, e-l:Expr)) = true /\ match-type-BOOL-0(Check-expr(tenv:List, e-r:Expr)) = true .
  eq Check-command(tenv:List, variant-command-SKIP-0) = tenv:List .
  ceq Check-command(tenv:List, command:Command) = cons(variant-pair-minus-gt-2(x:Id, t:Type), tenv:List) if match-command-eq-3(command:Command) = true /\ command:Command = variant-command-eq-3(t:Type, x:Id, e:Expr) /\ Check-expr(tenv:List, e:Expr) = t:Type .
  ceq Check-command(tenv:List, command:Command) = tenv:List if match-command-eq-2(command:Command) = true /\ command:Command = variant-command-eq-2(x:Id, e:Expr) /\ $lookup(tenv:List, x:Id) = some(Check-expr(tenv:List, e:Expr)) .
  ceq Check-command(tenv:List, command:Command) = tenv:List if match-command-IF-THEN-ELSE-END-3(command:Command) = true /\ command:Command = variant-command-IF-THEN-ELSE-END-3(e:Expr, c-1:Command, c-2:Command) /\ match-type-BOOL-0(Check-expr(tenv:List, e:Expr)) = true /\ Check-command(tenv:List, c-1:Command) = tenv-1:List /\ Check-command(tenv:List, c-2:Command) = tenv-2:List .
  ceq Check-command(tenv:List, command:Command) = tenv:List if match-command-WHILE-DO-END-2(command:Command) = true /\ command:Command = variant-command-WHILE-DO-END-2(e:Expr, c:Command) /\ match-type-BOOL-0(Check-expr(tenv:List, e:Expr)) = true /\ Check-command(tenv:List, c:Command) = tenv-1:List .
  ceq Check-command(tenv:List, command:Command) = Check-command(Check-command(tenv:List, c-1:Command), c-2:Command) if match-command-semi-2(command:Command) = true /\ command:Command = variant-command-semi-2(c-1:Command, c-2:Command) .
  ceq Check-prog(command:Command) = true if Check-command(nil, command:Command) = tenv:List .
  ceq Eval-expr(env:List, expr:Literal) = variant-literal-NUM-1(i:IntV) if subty-literal(expr:Literal) = true /\ match-literal-NUM-1(expr:Literal) = true /\ expr:Literal = variant-literal-NUM-1(i:IntV) .
  ceq Eval-expr(env:List, expr:Literal) = variant-literal-BOOL-1(b:BoolV) if subty-literal(expr:Literal) = true /\ match-literal-BOOL-1(expr:Literal) = true /\ expr:Literal = variant-literal-BOOL-1(b:BoolV) .
  ceq Eval-expr(env:List, expr:Expr) = v:Literal if subty-id(expr:Expr) = true /\ $lookup(env:List, expr:Expr) = value:Opt /\ match-some(value:Opt) = true /\ value:Opt = some(v:Literal) .
  ceq Eval-expr(env:List, expr:Expr) = variant-literal-BOOL-1(not(b-e:BoolV)) if match-expr-bang-1(expr:Expr) = true /\ expr:Expr = variant-expr-bang-1(e:Expr) /\ Eval-expr(env:List, e:Expr) = literal:Literal /\ match-literal-BOOL-1(literal:Literal) = true /\ literal:Literal = variant-literal-BOOL-1(b-e:BoolV) .
  ceq Eval-expr(env:List, expr:Expr) = variant-literal-NUM-1(add-int(i-l:IntV, i-r:IntV)) if match-expr-plus-2(expr:Expr) = true /\ expr:Expr = variant-expr-plus-2(e-l:Expr, e-r:Expr) /\ Eval-expr(env:List, e-l:Expr) = literal:Literal /\ match-literal-NUM-1(literal:Literal) = true /\ literal:Literal = variant-literal-NUM-1(i-l:IntV) /\ Eval-expr(env:List, e-r:Expr) = literal-prime:Literal /\ match-literal-NUM-1(literal-prime:Literal) = true /\ literal-prime:Literal = variant-literal-NUM-1(i-r:IntV) .
  ceq Eval-expr(env:List, expr:Expr) = variant-literal-BOOL-1(leq-int(i-l:IntV, i-r:IntV)) if match-expr-lt-eq-2(expr:Expr) = true /\ expr:Expr = variant-expr-lt-eq-2(e-l:Expr, e-r:Expr) /\ Eval-expr(env:List, e-l:Expr) = literal:Literal /\ match-literal-NUM-1(literal:Literal) = true /\ literal:Literal = variant-literal-NUM-1(i-l:IntV) /\ Eval-expr(env:List, e-r:Expr) = literal-prime:Literal /\ match-literal-NUM-1(literal-prime:Literal) = true /\ literal-prime:Literal = variant-literal-NUM-1(i-r:IntV) .
  ceq Eval-expr(env:List, expr:Expr) = variant-literal-BOOL-1(and(b-l:BoolV, b-r:BoolV)) if match-expr-amp-amp-2(expr:Expr) = true /\ expr:Expr = variant-expr-amp-amp-2(e-l:Expr, e-r:Expr) /\ Eval-expr(env:List, e-l:Expr) = literal:Literal /\ match-literal-BOOL-1(literal:Literal) = true /\ literal:Literal = variant-literal-BOOL-1(b-l:BoolV) /\ Eval-expr(env:List, e-r:Expr) = literal-prime:Literal /\ match-literal-BOOL-1(literal-prime:Literal) = true /\ literal-prime:Literal = variant-literal-BOOL-1(b-r:BoolV) .
  eq Eval-command(env:List, variant-command-SKIP-0) = env:List .
  ceq Eval-command(env:List, command:Command) = cons(variant-pair-minus-gt-2(x:Id, Eval-expr(env:List, e:Expr)), env:List) if match-command-eq-3(command:Command) = true /\ command:Command = variant-command-eq-3(t:Type, x:Id, e:Expr) .
  ceq Eval-command(env:List, command:Command) = cons(variant-pair-minus-gt-2(x:Id, Eval-expr(env:List, e:Expr)), env:List) if match-command-eq-2(command:Command) = true /\ command:Command = variant-command-eq-2(x:Id, e:Expr) .
  ceq Eval-command(env:List, command:Command) = Eval-command(env:List, c-1:Command) if match-command-IF-THEN-ELSE-END-3(command:Command) = true /\ command:Command = variant-command-IF-THEN-ELSE-END-3(e:Expr, c-1:Command, c-2:Command) /\ Eval-expr(env:List, e:Expr) = variant-literal-BOOL-1(true) .
  ceq Eval-command(env:List, command:Command) = Eval-command(env:List, c-2:Command) if match-command-IF-THEN-ELSE-END-3(command:Command) = true /\ command:Command = variant-command-IF-THEN-ELSE-END-3(e:Expr, c-1:Command, c-2:Command) /\ Eval-expr(env:List, e:Expr) = variant-literal-BOOL-1(false) .
  ceq Eval-command(env:List, command:Command) = env:List if match-command-WHILE-DO-END-2(command:Command) = true /\ command:Command = variant-command-WHILE-DO-END-2(e:Expr, c:Command) /\ Eval-expr(env:List, e:Expr) = variant-literal-BOOL-1(false) .
  ceq Eval-command(env:List, command:Command) = Eval-command(Eval-command(env:List, c:Command), variant-command-WHILE-DO-END-2(e:Expr, c:Command)) if match-command-WHILE-DO-END-2(command:Command) = true /\ command:Command = variant-command-WHILE-DO-END-2(e:Expr, c:Command) /\ Eval-expr(env:List, e:Expr) = variant-literal-BOOL-1(true) .
  ceq Eval-command(env:List, command:Command) = Eval-command(Eval-command(env:List, c-1:Command), c-2:Command) if match-command-semi-2(command:Command) = true /\ command:Command = variant-command-semi-2(c-1:Command, c-2:Command) .
  eq Eval-prog(command:Command) = Eval-command(nil, command:Command) .
  ceq Run-prog(command:Command) = Eval-prog(command:Command) if Check-prog(command:Command) = true .
  eq eqg(x:Val, x:Val) = true .
  eq proj-cons-0(cons(x0:Val, x1:List)) = x0:Val .
  eq proj-variant-pair-minus-gt-2-0(variant-pair-minus-gt-2(x0:Val, x1:Val)) = x0:Val .
endm)

