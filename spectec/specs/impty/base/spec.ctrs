set include BOOL off .

(mod SPEC is
  sort Term .
  op not : Term -> Term .
  op true : -> Term .
  op false : -> Term .
  op and : Term Term -> Term .
  op add : Term Term -> Term .
  op zero : -> Term .
  op succ : Term -> Term .
  op leq : Term Term -> Term .
  op sub-int-nat : Term Term -> Term .
  op int-pos : Term -> Term .
  op int-neg : Term -> Term .
  op add-int : Term Term -> Term .
  op leq-int : Term Term -> Term .
  op match-some : Term -> Term .
  op some : Term -> Term .
  op none : -> Term .
  op match-cons : Term -> Term .
  op cons : Term Term -> Term .
  op nil : -> Term .
  op match-nil : Term -> Term .
  op match-type-INT-0 : Term -> Term .
  op variant-type-INT-0 : -> Term .
  op variant-type-BOOL-0 : -> Term .
  op match-type-BOOL-0 : Term -> Term .
  op match-literal-NUM-1 : Term -> Term .
  op variant-literal-NUM-1 : Term -> Term .
  op variant-literal-BOOL-1 : Term -> Term .
  op match-literal-BOOL-1 : Term -> Term .
  op subty-literal : Term -> Term .
  op subty-id : Term -> Term .
  op variant-id-ID-1 : Term -> Term .
  op match-expr-bang-1 : Term -> Term .
  op variant-expr-bang-1 : Term -> Term .
  op variant-expr-plus-2 : Term Term -> Term .
  op variant-expr-lt-eq-2 : Term Term -> Term .
  op variant-expr-amp-amp-2 : Term Term -> Term .
  op match-expr-plus-2 : Term -> Term .
  op match-expr-lt-eq-2 : Term -> Term .
  op match-expr-amp-amp-2 : Term -> Term .
  op match-command-SKIP-0 : Term -> Term .
  op variant-command-SKIP-0 : -> Term .
  op variant-command-eq-3 : Term Term Term -> Term .
  op variant-command-eq-2 : Term Term -> Term .
  op variant-command-IF-THEN-ELSE-END-3 : Term Term Term -> Term .
  op variant-command-WHILE-DO-END-2 : Term Term -> Term .
  op variant-command-semi-2 : Term Term -> Term .
  op match-command-eq-3 : Term -> Term .
  op match-command-eq-2 : Term -> Term .
  op match-command-IF-THEN-ELSE-END-3 : Term -> Term .
  op match-command-WHILE-DO-END-2 : Term -> Term .
  op match-command-semi-2 : Term -> Term .
  op $itermap-K-t-minus-gt-V-t-list-2-pair : Term Term -> Term .
  op variant-pair-minus-gt-2 : Term Term -> Term .
  op $unzip-K-t-minus-gt-V-t-list-V-t : Term -> Term .
  op $unzip-K-t-minus-gt-V-t-list-K-t : Term -> Term .
  op $lookup : Term Term -> Term .
  op Check-expr : Term Term -> Term .
  op Check-command : Term Term -> Term .
  op Check-prog : Term -> Term .
  op Eval-expr : Term Term -> Term .
  op Eval-command : Term Term -> Term .
  op Eval-prog : Term -> Term .
  op Run-prog : Term -> Term .
  vars y x xs x0 x1 x2 K-t--hd K-t--tl V-t--hd V-t--tl --rest pair-lt-K-comma-V-gt K-query V-h K-h iterbind-0 K-t V-t tenv expr literal i b t type e e-l e-r type-prime command c-1 c-2 tenv-1 tenv-2 c env v value b-e i-l literal-prime i-r b-l b-r env-1 env-2 : Term .
  eq not(true) = false .
  eq not(false) = true .
  eq and(true, y) = y .
  eq and(false, y) = false .
  eq add(zero, y) = y .
  eq add(succ(x), y) = succ(add(x, y)) .
  eq leq(zero, y) = true .
  eq leq(succ(x), zero) = false .
  eq leq(succ(x), succ(y)) = leq(x, y) .
  eq sub-int-nat(zero, zero) = int-pos(zero) .
  eq sub-int-nat(succ(x), zero) = int-pos(succ(x)) .
  eq sub-int-nat(zero, succ(y)) = int-neg(y) .
  eq sub-int-nat(succ(x), succ(y)) = sub-int-nat(x, y) .
  eq add-int(int-pos(x), int-pos(y)) = int-pos(add(x, y)) .
  eq add-int(int-neg(x), int-neg(y)) = int-neg(succ(add(x, y))) .
  eq add-int(int-pos(x), int-neg(y)) = sub-int-nat(x, succ(y)) .
  eq add-int(int-neg(x), int-pos(y)) = sub-int-nat(y, succ(x)) .
  eq leq-int(int-pos(x), int-pos(y)) = leq(x, y) .
  eq leq-int(int-neg(x), int-neg(y)) = leq(y, x) .
  eq leq-int(int-pos(x), int-neg(y)) = false .
  eq leq-int(int-neg(x), int-pos(y)) = true .
  eq match-some(some(x)) = true .
  eq match-some(none) = false .
  eq match-cons(cons(x, xs)) = true .
  eq match-cons(nil) = false .
  eq match-nil(nil) = true .
  eq match-nil(cons(x, xs)) = false .
  eq match-type-INT-0(variant-type-INT-0) = true .
  eq match-type-INT-0(variant-type-BOOL-0) = false .
  eq match-type-BOOL-0(variant-type-INT-0) = false .
  eq match-type-BOOL-0(variant-type-BOOL-0) = true .
  eq match-literal-NUM-1(variant-literal-NUM-1(x0)) = true .
  eq match-literal-NUM-1(variant-literal-BOOL-1(x0)) = false .
  eq match-literal-BOOL-1(variant-literal-NUM-1(x0)) = false .
  eq match-literal-BOOL-1(variant-literal-BOOL-1(x0)) = true .
  eq subty-literal(variant-literal-NUM-1(x0)) = true .
  eq subty-literal(variant-literal-BOOL-1(x0)) = true .
  eq subty-id(variant-id-ID-1(x0)) = true .
  eq match-expr-bang-1(variant-literal-NUM-1(x0)) = false .
  eq match-expr-bang-1(variant-literal-BOOL-1(x0)) = false .
  eq match-expr-bang-1(variant-id-ID-1(x0)) = false .
  eq match-expr-bang-1(variant-expr-bang-1(x0)) = true .
  eq match-expr-bang-1(variant-expr-plus-2(x0, x1)) = false .
  eq match-expr-bang-1(variant-expr-lt-eq-2(x0, x1)) = false .
  eq match-expr-bang-1(variant-expr-amp-amp-2(x0, x1)) = false .
  eq match-expr-plus-2(variant-literal-NUM-1(x0)) = false .
  eq match-expr-plus-2(variant-literal-BOOL-1(x0)) = false .
  eq match-expr-plus-2(variant-id-ID-1(x0)) = false .
  eq match-expr-plus-2(variant-expr-bang-1(x0)) = false .
  eq match-expr-plus-2(variant-expr-plus-2(x0, x1)) = true .
  eq match-expr-plus-2(variant-expr-lt-eq-2(x0, x1)) = false .
  eq match-expr-plus-2(variant-expr-amp-amp-2(x0, x1)) = false .
  eq match-expr-lt-eq-2(variant-literal-NUM-1(x0)) = false .
  eq match-expr-lt-eq-2(variant-literal-BOOL-1(x0)) = false .
  eq match-expr-lt-eq-2(variant-id-ID-1(x0)) = false .
  eq match-expr-lt-eq-2(variant-expr-bang-1(x0)) = false .
  eq match-expr-lt-eq-2(variant-expr-plus-2(x0, x1)) = false .
  eq match-expr-lt-eq-2(variant-expr-lt-eq-2(x0, x1)) = true .
  eq match-expr-lt-eq-2(variant-expr-amp-amp-2(x0, x1)) = false .
  eq match-expr-amp-amp-2(variant-literal-NUM-1(x0)) = false .
  eq match-expr-amp-amp-2(variant-literal-BOOL-1(x0)) = false .
  eq match-expr-amp-amp-2(variant-id-ID-1(x0)) = false .
  eq match-expr-amp-amp-2(variant-expr-bang-1(x0)) = false .
  eq match-expr-amp-amp-2(variant-expr-plus-2(x0, x1)) = false .
  eq match-expr-amp-amp-2(variant-expr-lt-eq-2(x0, x1)) = false .
  eq match-expr-amp-amp-2(variant-expr-amp-amp-2(x0, x1)) = true .
  eq match-command-SKIP-0(variant-command-SKIP-0) = true .
  eq match-command-SKIP-0(variant-command-eq-3(x0, x1, x2)) = false .
  eq match-command-SKIP-0(variant-command-eq-2(x0, x1)) = false .
  eq match-command-SKIP-0(variant-command-IF-THEN-ELSE-END-3(x0, x1, x2)) = false .
  eq match-command-SKIP-0(variant-command-WHILE-DO-END-2(x0, x1)) = false .
  eq match-command-SKIP-0(variant-command-semi-2(x0, x1)) = false .
  eq match-command-eq-3(variant-command-SKIP-0) = false .
  eq match-command-eq-3(variant-command-eq-3(x0, x1, x2)) = true .
  eq match-command-eq-3(variant-command-eq-2(x0, x1)) = false .
  eq match-command-eq-3(variant-command-IF-THEN-ELSE-END-3(x0, x1, x2)) = false .
  eq match-command-eq-3(variant-command-WHILE-DO-END-2(x0, x1)) = false .
  eq match-command-eq-3(variant-command-semi-2(x0, x1)) = false .
  eq match-command-eq-2(variant-command-SKIP-0) = false .
  eq match-command-eq-2(variant-command-eq-3(x0, x1, x2)) = false .
  eq match-command-eq-2(variant-command-eq-2(x0, x1)) = true .
  eq match-command-eq-2(variant-command-IF-THEN-ELSE-END-3(x0, x1, x2)) = false .
  eq match-command-eq-2(variant-command-WHILE-DO-END-2(x0, x1)) = false .
  eq match-command-eq-2(variant-command-semi-2(x0, x1)) = false .
  eq match-command-IF-THEN-ELSE-END-3(variant-command-SKIP-0) = false .
  eq match-command-IF-THEN-ELSE-END-3(variant-command-eq-3(x0, x1, x2)) = false .
  eq match-command-IF-THEN-ELSE-END-3(variant-command-eq-2(x0, x1)) = false .
  eq match-command-IF-THEN-ELSE-END-3(variant-command-IF-THEN-ELSE-END-3(x0, x1, x2)) = true .
  eq match-command-IF-THEN-ELSE-END-3(variant-command-WHILE-DO-END-2(x0, x1)) = false .
  eq match-command-IF-THEN-ELSE-END-3(variant-command-semi-2(x0, x1)) = false .
  eq match-command-WHILE-DO-END-2(variant-command-SKIP-0) = false .
  eq match-command-WHILE-DO-END-2(variant-command-eq-3(x0, x1, x2)) = false .
  eq match-command-WHILE-DO-END-2(variant-command-eq-2(x0, x1)) = false .
  eq match-command-WHILE-DO-END-2(variant-command-IF-THEN-ELSE-END-3(x0, x1, x2)) = false .
  eq match-command-WHILE-DO-END-2(variant-command-WHILE-DO-END-2(x0, x1)) = true .
  eq match-command-WHILE-DO-END-2(variant-command-semi-2(x0, x1)) = false .
  eq match-command-semi-2(variant-command-SKIP-0) = false .
  eq match-command-semi-2(variant-command-eq-3(x0, x1, x2)) = false .
  eq match-command-semi-2(variant-command-eq-2(x0, x1)) = false .
  eq match-command-semi-2(variant-command-IF-THEN-ELSE-END-3(x0, x1, x2)) = false .
  eq match-command-semi-2(variant-command-WHILE-DO-END-2(x0, x1)) = false .
  eq match-command-semi-2(variant-command-semi-2(x0, x1)) = true .
  eq $itermap-K-t-minus-gt-V-t-list-2-pair(nil, nil) = nil .
  eq $itermap-K-t-minus-gt-V-t-list-2-pair(cons(K-t--hd, K-t--tl), cons(V-t--hd, V-t--tl)) = cons(variant-pair-minus-gt-2(K-t--hd, V-t--hd), $itermap-K-t-minus-gt-V-t-list-2-pair(K-t--tl, V-t--tl)) .
  eq $unzip-K-t-minus-gt-V-t-list-V-t(nil) = nil .
  eq $unzip-K-t-minus-gt-V-t-list-V-t(cons(variant-pair-minus-gt-2(K-t--hd, V-t--hd), --rest)) = cons(V-t--hd, $unzip-K-t-minus-gt-V-t-list-V-t(--rest)) .
  eq $unzip-K-t-minus-gt-V-t-list-K-t(nil) = nil .
  eq $unzip-K-t-minus-gt-V-t-list-K-t(cons(variant-pair-minus-gt-2(K-t--hd, V-t--hd), --rest)) = cons(K-t--hd, $unzip-K-t-minus-gt-V-t-list-K-t(--rest)) .
  ceq $lookup(pair-lt-K-comma-V-gt, K-query) = none if match-nil(pair-lt-K-comma-V-gt) = true .
  ceq $lookup(pair-lt-K-comma-V-gt, K-query) = some(V-h) if match-cons(pair-lt-K-comma-V-gt) = true /\ pair-lt-K-comma-V-gt = cons(variant-pair-minus-gt-2(K-h, V-h), iterbind-0) /\ $unzip-K-t-minus-gt-V-t-list-K-t(iterbind-0) = K-t /\ $unzip-K-t-minus-gt-V-t-list-V-t(iterbind-0) = V-t /\ K-h = K-query .
  ceq $lookup(pair-lt-K-comma-V-gt, K-query) = $lookup($itermap-K-t-minus-gt-V-t-list-2-pair(K-t, V-t), K-query) if match-cons(pair-lt-K-comma-V-gt) = true /\ pair-lt-K-comma-V-gt = cons(variant-pair-minus-gt-2(K-h, V-h), iterbind-0) /\ $unzip-K-t-minus-gt-V-t-list-K-t(iterbind-0) = K-t /\ $unzip-K-t-minus-gt-V-t-list-V-t(iterbind-0) = V-t [owise] .
  ceq Check-expr(tenv, expr) = variant-type-INT-0 if subty-literal(expr) = true /\ expr = literal /\ match-literal-NUM-1(literal) = true /\ literal = variant-literal-NUM-1(i) .
  ceq Check-expr(tenv, expr) = variant-type-BOOL-0 if subty-literal(expr) = true /\ expr = literal /\ match-literal-BOOL-1(literal) = true /\ literal = variant-literal-BOOL-1(b) .
  ceq Check-expr(tenv, expr) = t if subty-id(expr) = true /\ expr = x /\ $lookup(tenv, x) = type /\ match-some(type) = true /\ type = some(t) .
  ceq Check-expr(tenv, expr) = variant-type-BOOL-0 if match-expr-bang-1(expr) = true /\ expr = variant-expr-bang-1(e) /\ Check-expr(tenv, e) = type /\ match-type-BOOL-0(type) = true .
  ceq Check-expr(tenv, expr) = variant-type-INT-0 if match-expr-plus-2(expr) = true /\ expr = variant-expr-plus-2(e-l, e-r) /\ Check-expr(tenv, e-l) = type /\ match-type-INT-0(type) = true /\ Check-expr(tenv, e-r) = type-prime /\ match-type-INT-0(type-prime) = true .
  ceq Check-expr(tenv, expr) = variant-type-BOOL-0 if match-expr-lt-eq-2(expr) = true /\ expr = variant-expr-lt-eq-2(e-l, e-r) /\ Check-expr(tenv, e-l) = type /\ match-type-INT-0(type) = true /\ Check-expr(tenv, e-r) = type-prime /\ match-type-INT-0(type-prime) = true .
  ceq Check-expr(tenv, expr) = variant-type-BOOL-0 if match-expr-amp-amp-2(expr) = true /\ expr = variant-expr-amp-amp-2(e-l, e-r) /\ Check-expr(tenv, e-l) = type /\ match-type-BOOL-0(type) = true /\ Check-expr(tenv, e-r) = type-prime /\ match-type-BOOL-0(type-prime) = true .
  ceq Check-command(tenv, command) = tenv if match-command-SKIP-0(command) = true .
  ceq Check-command(tenv, command) = cons(variant-pair-minus-gt-2(x, t), tenv) if match-command-eq-3(command) = true /\ command = variant-command-eq-3(t, x, e) /\ Check-expr(tenv, e) = type /\ type = t .
  ceq Check-command(tenv, command) = tenv if match-command-eq-2(command) = true /\ command = variant-command-eq-2(x, e) /\ Check-expr(tenv, e) = t /\ $lookup(tenv, x) = some(t) .
  ceq Check-command(tenv, command) = tenv if match-command-IF-THEN-ELSE-END-3(command) = true /\ command = variant-command-IF-THEN-ELSE-END-3(e, c-1, c-2) /\ Check-expr(tenv, e) = type /\ match-type-BOOL-0(type) = true /\ Check-command(tenv, c-1) = tenv-1 /\ Check-command(tenv, c-2) = tenv-2 .
  ceq Check-command(tenv, command) = tenv if match-command-WHILE-DO-END-2(command) = true /\ command = variant-command-WHILE-DO-END-2(e, c) /\ Check-expr(tenv, e) = type /\ match-type-BOOL-0(type) = true /\ Check-command(tenv, c) = tenv-1 .
  ceq Check-command(tenv, command) = tenv-2 if match-command-semi-2(command) = true /\ command = variant-command-semi-2(c-1, c-2) /\ Check-command(tenv, c-1) = tenv-1 /\ Check-command(tenv-1, c-2) = tenv-2 .
  ceq Check-prog(command) = true if Check-command(nil, command) = tenv .
  ceq Eval-expr(env, expr) = variant-literal-NUM-1(i) if subty-literal(expr) = true /\ expr = literal /\ match-literal-NUM-1(literal) = true /\ literal = variant-literal-NUM-1(i) .
  ceq Eval-expr(env, expr) = variant-literal-BOOL-1(b) if subty-literal(expr) = true /\ expr = literal /\ match-literal-BOOL-1(literal) = true /\ literal = variant-literal-BOOL-1(b) .
  ceq Eval-expr(env, expr) = v if subty-id(expr) = true /\ expr = x /\ $lookup(env, x) = value /\ match-some(value) = true /\ value = some(v) .
  ceq Eval-expr(env, expr) = variant-literal-BOOL-1(b) if match-expr-bang-1(expr) = true /\ expr = variant-expr-bang-1(e) /\ Eval-expr(env, e) = literal /\ match-literal-BOOL-1(literal) = true /\ literal = variant-literal-BOOL-1(b-e) /\ not(b-e) = b .
  ceq Eval-expr(env, expr) = variant-literal-NUM-1(i) if match-expr-plus-2(expr) = true /\ expr = variant-expr-plus-2(e-l, e-r) /\ Eval-expr(env, e-l) = literal /\ match-literal-NUM-1(literal) = true /\ literal = variant-literal-NUM-1(i-l) /\ Eval-expr(env, e-r) = literal-prime /\ match-literal-NUM-1(literal-prime) = true /\ literal-prime = variant-literal-NUM-1(i-r) /\ add-int(i-l, i-r) = i .
  ceq Eval-expr(env, expr) = variant-literal-BOOL-1(b) if match-expr-lt-eq-2(expr) = true /\ expr = variant-expr-lt-eq-2(e-l, e-r) /\ Eval-expr(env, e-l) = literal /\ match-literal-NUM-1(literal) = true /\ literal = variant-literal-NUM-1(i-l) /\ Eval-expr(env, e-r) = literal-prime /\ match-literal-NUM-1(literal-prime) = true /\ literal-prime = variant-literal-NUM-1(i-r) /\ leq-int(i-l, i-r) = b .
  ceq Eval-expr(env, expr) = variant-literal-BOOL-1(b) if match-expr-amp-amp-2(expr) = true /\ expr = variant-expr-amp-amp-2(e-l, e-r) /\ Eval-expr(env, e-l) = literal /\ match-literal-BOOL-1(literal) = true /\ literal = variant-literal-BOOL-1(b-l) /\ Eval-expr(env, e-r) = literal-prime /\ match-literal-BOOL-1(literal-prime) = true /\ literal-prime = variant-literal-BOOL-1(b-r) /\ and(b-l, b-r) = b .
  ceq Eval-command(env, command) = env if match-command-SKIP-0(command) = true .
  ceq Eval-command(env, command) = cons(variant-pair-minus-gt-2(x, v), env) if match-command-eq-3(command) = true /\ command = variant-command-eq-3(t, x, e) /\ Eval-expr(env, e) = v .
  ceq Eval-command(env, command) = cons(variant-pair-minus-gt-2(x, v), env) if match-command-eq-2(command) = true /\ command = variant-command-eq-2(x, e) /\ Eval-expr(env, e) = v .
  ceq Eval-command(env, command) = env-1 if match-command-IF-THEN-ELSE-END-3(command) = true /\ command = variant-command-IF-THEN-ELSE-END-3(e, c-1, c-2) /\ Eval-expr(env, e) = literal /\ literal = variant-literal-BOOL-1(true) /\ Eval-command(env, c-1) = env-1 .
  ceq Eval-command(env, command) = env-2 if match-command-IF-THEN-ELSE-END-3(command) = true /\ command = variant-command-IF-THEN-ELSE-END-3(e, c-1, c-2) /\ Eval-expr(env, e) = literal /\ literal = variant-literal-BOOL-1(false) /\ Eval-command(env, c-2) = env-2 .
  ceq Eval-command(env, command) = env if match-command-WHILE-DO-END-2(command) = true /\ command = variant-command-WHILE-DO-END-2(e, c) /\ Eval-expr(env, e) = literal /\ literal = variant-literal-BOOL-1(false) .
  ceq Eval-command(env, command) = env-2 if match-command-WHILE-DO-END-2(command) = true /\ command = variant-command-WHILE-DO-END-2(e, c) /\ Eval-expr(env, e) = literal /\ literal = variant-literal-BOOL-1(true) /\ Eval-command(env, c) = env-1 /\ Eval-command(env-1, variant-command-WHILE-DO-END-2(e, c)) = env-2 .
  ceq Eval-command(env, command) = env-2 if match-command-semi-2(command) = true /\ command = variant-command-semi-2(c-1, c-2) /\ Eval-command(env, c-1) = env-1 /\ Eval-command(env-1, c-2) = env-2 .
  ceq Eval-prog(command) = env if Eval-command(nil, command) = env .
  ceq Run-prog(command) = env if Check-prog(command) = true /\ Eval-prog(command) = env .
endm)

