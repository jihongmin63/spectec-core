  ceq Eval_expr(env, expr) = variant_literal_NUM_1(i) if match_expr_plus_2(expr) = true /\ expr = variant_expr_plus_2(e_l, e_r) /\ Eval_expr(env, e_l) = literal /\ match_literal_NUM_1(literal) = true /\ literal = variant_literal_NUM_1(i_l) /\ Eval_expr(env, e_r) = literal' /\ match_literal_NUM_1(literal') = true /\ literal' = variant_literal_NUM_1(i_r) /\ add_int(i_l, i_r) = i .
  ceq Eval_expr(env, expr) = variant_literal_BOOL_1(b) if match_expr_lt_eq_2(expr) = true /\ expr = variant_expr_lt_eq_2(e_l, e_r) /\ Eval_expr(env, e_l) = literal /\ match_literal_NUM_1(literal) = true /\ literal = variant_literal_NUM_1(i_l) /\ Eval_expr(env, e_r) = literal' /\ match_literal_NUM_1(literal') = true /\ literal' = variant_literal_NUM_1(i_r) /\ leq_int(i_l, i_r) = b .
  ceq Eval_expr(env, expr) = variant_literal_BOOL_1(b) if match_expr_amp_amp_2(expr) = true /\ expr = variant_expr_amp_amp_2(e_l, e_r) /\ Eval_expr(env, e_l) = literal /\ match_literal_BOOL_1(literal) = true /\ literal = variant_literal_BOOL_1(b_l) /\ Eval_expr(env, e_r) = literal' /\ match_literal_BOOL_1(literal') = true /\ literal' = variant_literal_BOOL_1(b_r) /\ and(b_l, b_r) = b .
  ceq Eval_command(env, command) = env if match_command_SKIP_0(command) = true .
  ceq Eval_command(env, command) = cons(variant_pair_minus_gt_2(x, v), env) if match_command_eq_3(command) = true /\ command = variant_command_eq_3(t, x, e) /\ Eval_expr(env, e) = v .
  ceq Eval_command(env, command) = cons(variant_pair_minus_gt_2(x, v), env) if match_command_eq_2(command) = true /\ command = variant_command_eq_2(x, e) /\ Eval_expr(env, e) = v .
  ceq Eval_command(env, command) = env_1 if match_command_IF_THEN_ELSE_END_3(command) = true /\ command = variant_command_IF_THEN_ELSE_END_3(e, c_1, c_2) /\ Eval_expr(env, e) = literal /\ literal = variant_literal_BOOL_1(true) /\ Eval_command(env, c_1) = env_1 .
  ceq Eval_command(env, command) = env_2 if match_command_IF_THEN_ELSE_END_3(command) = true /\ command = variant_command_IF_THEN_ELSE_END_3(e, c_1, c_2) /\ Eval_expr(env, e) = literal /\ literal = variant_literal_BOOL_1(false) /\ Eval_command(env, c_2) = env_2 .
  ceq Eval_command(env, command) = env if match_command_WHILE_DO_END_2(command) = true /\ command = variant_command_WHILE_DO_END_2(e, c) /\ Eval_expr(env, e) = literal /\ literal = variant_literal_BOOL_1(false) .
  ceq Eval_command(env, command) = env_2 if match_command_WHILE_DO_END_2(command) = true /\ command = variant_command_WHILE_DO_END_2(e, c) /\ Eval_expr(env, e) = literal /\ literal = variant_literal_BOOL_1(true) /\ Eval_command(env, c) = env_1 /\ Eval_command(env_1, variant_command_WHILE_DO_END_2(e, c)) = env_2 .
