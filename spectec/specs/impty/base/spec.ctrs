  eq $itermap_K_t_minus_gt_V_t_list_2_pair(cons(K_t__hd, K_t__tl), cons(V_t__hd, V_t__tl)) = cons(variant_pair_minus_gt_2(K_t__hd, V_t__hd), $itermap_K_t_minus_gt_V_t_list_2_pair(K_t__tl, V_t__tl)) .
  eq $unzip_K_t_minus_gt_V_t_list_V_t(nil) = nil .
